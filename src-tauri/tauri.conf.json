{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petari",
  "version": "0.1.0",
  "identifier": "io.github.subirsh.petari",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Petari",
        "width": 340,
        "height": 360,
        "minWidth": 240,
        "minHeight": 180,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis"
  }
}
